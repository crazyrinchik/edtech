{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "stand",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file-if-exists=.env", "deploy/stand.mjs"],
      "port": 8788,
      "autoPort": true
    },
    {
      "name": "stand-2",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=8790", "STAND_DATA=deploy/.stand/2", "node", "--env-file-if-exists=.env", "deploy/stand.mjs"],
      "port": 8790
    }
  ]
}
